{
  "name": "web-app",
  "version": "1.0.0",
  "description": "Web application",
  "type": "module",
  "main": "src/server/index.js",
  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "node --watch src/server/index.js",
    "dev:client": "next dev -p ${CLIENT_PORT:-3001}",
    "start": "node src/server/index.js",
    "build": "next build",
    "start:prod": "node src/server/index.js",
    "test": "node --test tests/**/*.test.js",
    "test:api": "node --test tests/api*.test.js",
    "test:client": "node --test tests/client.test.js",
    "test:setup": "node --test tests/setup.test.js",
    "test:env": "node --test tests/env.test.js",
    "test:static": "node --test tests/static-endpoints.test.js",
    "test:all": "./bin/test-all-env.sh",
    "test:dev": "NODE_ENV=development node --test tests/**/*.test.js",
    "test:prod": "NODE_ENV=production node --test tests/**/*.test.js",
    "format": "prettier --write \"src/**/*.{js,jsx,json}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json}\" \"*.{js,json,md}\"",
    "lint": "eslint src/**/*.js",
    "docker:build": "docker build -t web-app .",
    "docker:run": "docker-compose up -d",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:caddy": "docker-compose -f docker-compose.caddy.yml up -d",
    "docker:caddy:local": "docker-compose -f docker-compose.caddy.local.yml up",
    "docker:caddy:local:detached": "docker-compose -f docker-compose.caddy.local.yml up -d",
    "docker:caddy:local:logs": "docker-compose -f docker-compose.caddy.local.yml logs -f"
  },
  "keywords": [
    "web",
    "application"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "9.0.1",
    "@fastify/formbody": "7.4.0",
    "@fastify/multipart": "8.3.1",
    "@fastify/static": "6.12.0",
    "@fastify/swagger": "8.15.0",
    "@fastify/swagger-ui": "2.1.0",
    "fastify": "4.29.1",
    "next": "14.2.33",
    "pdfkit": "0.15.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@types/node": "20.19.25",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "concurrently": "8.2.2",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.33",
    "prettier": "3.4.2",
    "typescript": "5.9.3"
  }
}
